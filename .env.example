# =====================================================
# MLOps Customer Churn Prediction - Environment Variables
# =====================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# =====================================================

# Azure ML Endpoint - API key for authentication
AZURE_ML_PRIMARY_KEY="your_azure_ml_primary_key_here"

# Azure Cache for Redis - Connection string for Feast Online Store
# Format: host:port,password=xxx,ssl=True
REDIS_CONNECTION_STRING="churn-feast-redis.redis.cache.windows.net:6380,password=your_redis_password_here,ssl=True"

# Azure Blob Storage - Connection string for DVC and feedback uploads
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=your_account;AccountKey=your_key_here"
